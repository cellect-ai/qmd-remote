FROM oven/bun:1.3.13-slim@sha256:7e8ed3961db1cdedf17d516dda87948cfedbd294f53bf16462e5b57ed3fff0f1 AS dependencies

ARG DEBIAN_FRONTEND=noninteractive
USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends g++ make python3 \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/qmd
COPY package.json bun.lock ./
# QMD's upstream package prepare hook builds distributable artifacts. This
# sidecar executes the checked-in TypeScript source directly, so the hook's
# scripts are intentionally absent from this minimal runtime build.
RUN bun install --frozen-lockfile --production --ignore-scripts

FROM oven/bun:1.3.13-slim@sha256:7e8ed3961db1cdedf17d516dda87948cfedbd294f53bf16462e5b57ed3fff0f1

ARG DEBIAN_FRONTEND=noninteractive
USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/qmd
COPY --from=dependencies --chown=1000:1000 /opt/qmd/node_modules /opt/qmd/node_modules
COPY --chown=1000:1000 package.json bun.lock ./
COPY --chown=1000:1000 src /opt/qmd/src
RUN printf '#!/bin/sh\nexport HOME=/home/node\nif [ "$1" = "qdrant-import" ]; then\n  shift\n  exec /usr/local/bin/bun /opt/qmd/src/qdrant-import.ts "$@"\nfi\nexec /usr/local/bin/bun /opt/qmd/src/cli/qmd.ts "$@"\n' \
      > /usr/local/bin/qmd \
  && chmod 0755 /usr/local/bin/qmd \
  && install -d -o 1000 -g 1000 -m 0755 /home/node

USER 1000:1000
ENV HOME=/home/node
ENV INDEX_PATH=/home/node/.qmd/index.sqlite
ENV QMD_CONFIG_DIR=/home/node/.qmd
# Keep execution independent of HOME's project discovery. QMD_CONFIG_DIR is
# the operator's choice, so its config is trusted like the global one and needs
# no `qmd trust`; configs chosen on the CLI stay behind upstream's trust gate.
WORKDIR /opt/qmd
